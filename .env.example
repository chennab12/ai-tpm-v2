# AI-TPM-v2 Configuration
# Copy to .env and fill in values

# HuggingFace (optional - for gated models)
HF_TOKEN=

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Jira (optional - for ticket analysis)
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_EMAIL=

# Benchmark defaults
DEFAULT_MODEL=distilgpt2
DEFAULT_MAX_NEW_TOKENS=128
DEFAULT_NUM_RUNS=5
DEFAULT_WARMUP_RUNS=1
